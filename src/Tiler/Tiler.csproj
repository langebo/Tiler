<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Shipped binary name; CI and packaging both invoke `tiler`. -->
    <AssemblyName>tiler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Tmds.DBus.SourceGenerator" Version="0.0.19" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Dbus/Windows.xml" DBusGeneratorMode="Proxy" />
  </ItemGroup>

</Project>
